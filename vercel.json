{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination":"https://andrews-invention-configured-circuit.trycloudflare.com/:path*"
    },
    {
      "source": "/media/:path*",
      "destination":"https://andrews-invention-configured-circuit.trycloudflare.com/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}