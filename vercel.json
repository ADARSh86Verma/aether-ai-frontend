{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://candidates-sorts-maple-else.trycloudflare.com/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://candidates-sorts-maple-else.trycloudflare.com/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}